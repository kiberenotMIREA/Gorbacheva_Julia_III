# =============================================================================
# Настройки Vulnerability Scoring API
# =============================================================================
# Скопируйте этот файл в .env и измените значения при необходимости:
#   cp configs\.env.example .env
# =============================================================================

# --- Настройки сервиса -------------------------------------------------------
SERVICE_HOST=0.0.0.0                    # Хост сервера (0.0.0.0 — все интерфейсы)
SERVICE_PORT=8000                       # Порт FastAPI
LOG_LEVEL=INFO                          # Уровень логирования (DEBUG, INFO, WARNING, ERROR)

# --- Пути к моделям (относительно корня проекта) -----------------------------
MODEL_DIR=artifacts/models              # Директория со всеми моделями
LSTM_MODEL=lstm_model.keras            # BiLSTM модель (Keras v3, .keras)
TOKENIZER_PATH=tokenizer.json          # Char-level токенизатор LSTM
BERT_CLASSIFIER=bert_classifier.pkl    # LogisticRegression на BERT-эмбеддингах
HYBRID_CLASSIFIER=hybrid_classifier.pkl # Гибридный классификатор (LR)
HYBRID_SCALER=hybrid_scaler.pkl        # StandardScaler для гибрида
LSTM_FEATURE_EXTRACTOR=lstm_feature_extractor.keras  # Экстрактор penultimate-слоя LSTM
ENSEMBLE_META_CLF=ensemble_meta_clf.pkl  # Мета-классификатор стекинга
ENSEMBLE_META_SCALER=ensemble_meta_scaler.pkl  # Scaler для ансамбля

# --- Окружение TensorFlow / PyTorch ------------------------------------------
TF_ENABLE_ONEDNN_OPTS=0                 # Отключаем oneDNN (стабильность на CPU)
TF_CPP_MIN_LOG_LEVEL=2                  # Подавляем INFO-сообщения TF (только WARNING+)
CUDA_VISIBLE_DEVICES=-1                 # Отключаем поиск GPU (CPU-only режим)

# --- Данные -------------------------------------------------------
# HuggingFace токен (опционально, для лимитов)
HF_TOKEN=
HF_HUB_OFFLINE=1                        # Отключаем сетевые запросы HF Hub (используем кэш)
RANDOM_SEED=42                          # Seed для воспроизводимости

# --- Трекинг экспериментов (MLflow) -------------------------------------------
TRACKING_URI=artifacts/mlruns           # Директория для MLflow логов
